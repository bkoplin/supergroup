{
  "name": "supergroup",
  "type": "module",
  "version": "2.0.0-beta.2",
  "packageManager": "pnpm@9.14.3",
  "license": "MIT",
  "homepage": "https://github.com/bkoplin/supergroup#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bkoplin/supergroup.git"
  },
  "bugs": "https://github.com/bkoplin/supergroup/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "bump": "op run --env-file=\"./.env\" -- pnpm bumpp",
    "bump:up": "pnpm bump && pnpm changelog",
    "changelog": "op run --env-file=\"./.env\" -- changelogithub GITHUB_TOKEN",
    "dev": "unbuild --stub",
    "lint": "eslint .",
    "prepublishOnly": "nr build",
    "release": "bumpp && pnpm publish",
    "start": "esno src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@types/lodash": "^4.17.13",
    "lodash": "^4.17.21",
    "radash": "^12.1.0",
    "type-fest": "^4.29.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.11.2",
    "@antfu/ni": "^0.23.1",
    "@antfu/utils": "^0.7.10",
    "@types/node": "^22.10.1",
    "bumpp": "^9.8.1",
    "changelogithub": "^0.13.11",
    "eslint": "^9.15.0",
    "esno": "^4.8.0",
    "lint-staged": "^15.2.10",
    "pnpm": "^9.14.3",
    "typescript": "^5.7.2",
    "unbuild": "^2.0.0",
    "vite": "^6.0.1",
    "vitest": "^2.1.6"
  }
}
